POSTGRES_PASSWORD=*********
RABBITMQ_USERNAME=dc3
RABBITMQ_PASSWORD=*********
MQTT_USERNAME=dc3
MQTT_PASSWORD=*********
DC3_SECURITY_KEY=dc3.security.key.2026.io.github.pnoker
