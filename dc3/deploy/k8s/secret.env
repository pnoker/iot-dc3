# kustomize secretGenerator input -> Secret "dc3-secrets".
# DEFAULTS BELOW ARE PUBLIC WEAK VALUES - COPY THIS FILE TO secret.env, EDIT
# THEM, AND NEVER COMMIT REAL SECRETS. Production must use strong random
# values for DC3_SECURITY_KEY / AUTH_HMAC_SECRET / passwords (see
# dc3/doc/DEPLOYMENT.md "Production hardening").
POSTGRES_USERNAME=dc3
POSTGRES_PASSWORD=*********
RABBITMQ_USERNAME=dc3
RABBITMQ_PASSWORD=*********
MQTT_USERNAME=dc3
MQTT_PASSWORD=*********
DC3_SECURITY_KEY=dc3.security.key.2026.io.github.pnoker
# REQUIRED in pre/pro: set a deployment-specific value, e.g. `openssl rand -hex 32`.
# Blank disables principal signing in dev/test only; pre/pro startup rejects blank
# and rejects the historical public default.
AUTH_HMAC_SECRET=
AGENTIC_FALLBACK_OPENAI_API_KEY=
