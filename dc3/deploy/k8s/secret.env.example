# kustomize secretGenerator input -> Secret "dc3-secrets".
# DEFAULTS BELOW ARE PUBLIC WEAK VALUES (same as the dev compose stacks) -
# COPY THIS FILE TO secret.env, EDIT THEM, AND NEVER COMMIT REAL SECRETS.
# Production must use strong random values for DC3_SECURITY_KEY /
# AUTH_HMAC_SECRET / passwords (see dc3/doc/DEPLOYMENT.md "Production
# hardening").
POSTGRES_USERNAME=dc3
POSTGRES_PASSWORD=dc3dc3dc3
RABBITMQ_USERNAME=dc3
RABBITMQ_PASSWORD=dc3dc3dc3
MQTT_USERNAME=dc3
MQTT_PASSWORD=dc3dc3dc3
DC3_SECURITY_KEY=dc3.security.key.2026.io.github.pnoker
# REQUIRED in pre/pro: set a deployment-specific value, e.g.
# `openssl rand -hex 32`. Blank disables principal signing in dev/test only;
# pre/pro startup rejects blank AND rejects the historical public default
# (io.github.pnoker.dc3) - do not put that value here.
AUTH_HMAC_SECRET=
AGENTIC_FALLBACK_OPENAI_API_KEY=
