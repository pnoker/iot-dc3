{
  "name": "dc3-cli",
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "description": "IoT DC3 Platform CLI — AI-ready command-line interface for the DC3 IoT platform",
  "keywords": [
    "iot",
    "dc3",
    "cli",
    "ai-agent",
    "mcp",
    "industrial-iot"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "pnoker",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dc3": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm typecheck && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "headers": "find src -name '*.ts' | xargs node scripts/add-license-header.mjs",
    "headers:check": "find src -name '*.ts' | xargs node scripts/add-license-header.mjs --check"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.3.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^64.5.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
