{
  "name": "dc3-cli",
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "description": "IoT DC3 Platform CLI — AI-ready command-line interface for the DC3 IoT platform",
  "keywords": [
    "iot",
    "dc3",
    "cli",
    "ai-agent",
    "mcp",
    "industrial-iot"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "pnoker",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dc3": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm typecheck && tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --fix",
    "lint:check": "eslint src test",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "headers": "git ls-files \"src/**/*.ts\" | xargs node scripts/add-license-header.mjs",
    "headers:check": "git ls-files \"src/**/*.ts\" | xargs node scripts/add-license-header.mjs --check"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
