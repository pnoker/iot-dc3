<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pnoker</groupId>
        <artifactId>dc3-tsdb</artifactId>
        <version>2026.5.22</version>
    </parent>

    <artifactId>dc3-tsdb-iotdb</artifactId>
    <name>${project.artifactId}</name>
    <description>Apache IoTDB adapter of the TSDB port — tree paths root.dc3.* over the session API; requires
        timestamp_precision=us
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.pnoker</groupId>
            <artifactId>dc3-tsdb-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.iotdb</groupId>
            <artifactId>iotdb-session</artifactId>
            <version>2.0.10</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>

</project>
