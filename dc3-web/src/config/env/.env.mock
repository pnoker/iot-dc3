# Mock dev server (`pnpm dev:mock`): requests are served by the in-app mock
# adapter; the proxy only exists as a fallback for endpoints the mock does not
# cover yet, pointing at the local dc3 stack like the dev profile.
APP_CLI_PORT=8081
APP_API_PREFIX=/api/v3
APP_API_PATH=http://127.0.0.1
APP_API_PORT=8080

# Static demo build: ships a mock axios adapter, no backend needed.
# The runtime gate in main.ts checks `import.meta.env.MODE === 'mock'`.
APP_MOCK = "true"
