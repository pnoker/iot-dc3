# Local dev server (`pnpm dev`): API calls proxy to the local dc3 stack's
# web nginx (127.0.0.1:8080), which reverse-proxies to the gateway. The CLI
# port stays off 8080 so the dockerized web container can keep running.
APP_CLI_PORT=8081
APP_API_PREFIX=/api/v3
APP_API_PATH=http://127.0.0.1
APP_API_PORT=8080
