<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pnoker</groupId>
        <artifactId>iot-dc3</artifactId>
        <version>2026.5.22</version>
    </parent>

    <artifactId>dc3-db</artifactId>
    <name>${project.artifactId}</name>
    <packaging>pom</packaging>
    <description>Relational dialect family: one adapter per engine behind dc3.db.type — see
        docs/design/storage-abstraction.md §3 and docs/tsdb-stores.md for the sibling families
    </description>

    <modules>
        <module>dc3-db-r2dbc-core</module>
        <module>dc3-db-r2dbc-runtime</module>
        <module>dc3-db-r2dbc-postgres</module>
        <module>dc3-db-postgres-auth</module>
        <module>dc3-db-postgres-manager</module>
        <module>dc3-db-postgres-data</module>
        <module>dc3-db-postgres-agentic</module>
        <module>dc3-db-tck</module>
    </modules>

</project>
