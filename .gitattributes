# Default: normalize all text to LF in the repository. Without this a
# Windows clone (core.autocrlf=true) checks out CRLF working trees, which
# spotless's origin/main ratchet then treats as whole-repo changes and the
# format gate fails everywhere. Platform-specific exceptions follow.
* text=auto eol=lf

# Windows scripts keep CRLF on purpose
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.jar binary
*.db binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.qcow2 binary
*.dylib binary
*.jnilib binary
*.so binary
*.dll binary
*.ttf binary
*.woff binary
*.woff2 binary

# Historic specific rules kept for clarity (subsumed above but explicit)
mvnw text eol=lf
mvnw.cmd text eol=crlf
